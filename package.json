{
  "name": "raid-game-client",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Рейд — браузерная survival/extraction-игра (React + ASP.NET Core)",
  "author": "X3V-Mann",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:api": "vite build --outDir GameApi/wwwroot --emptyOutDir",
    "preview": "vite preview",
    "lint": "eslint .",
    "electron:dev": "electron .",
    "desktop:prepare": "npm run build:api && dotnet publish GameApi/GameApi.csproj -c Release -r win-x64 --self-contained true -o build/api",
    "desktop:build": "npm run desktop:prepare && electron-builder --win --x64 --publish never",
    "desktop:publish": "npm run desktop:prepare && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.x3vmann.raidgame",
    "productName": "Raid Game",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/api",
        "to": "api",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "X3V-Mann",
        "repo": "raid-game-client"
      }
    ]
  }
}
